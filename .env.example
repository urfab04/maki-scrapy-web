# --- Tienda ---------------------------------------------------------------
MAGENTO_BASE_URL=https://www.makito.eu

# Ajusta las rutas si la tienda usa prefijo de store view (p. ej. /es/customer/account/login/)
MAGENTO_LOGIN_PATH=/customer/account/login/
MAGENTO_LOGIN_POST_PATH=/customer/account/loginPost/
MAGENTO_ACCOUNT_PATH=/customer/account/

# --- Credenciales (nunca las comitees) ------------------------------------
MAGENTO_USERNAME=tu-email@ejemplo.com
MAGENTO_PASSWORD=tu-contrasena

# --- Comportamiento HTTP --------------------------------------------------
HTTP_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
HTTP_ACCEPT_LANGUAGE=es-ES,es;q=0.9,en;q=0.8
HTTP_TIMEOUT_MS=20000
HTTP_MAX_RETRIES=3
HTTP_RETRY_BASE_DELAY_MS=600
HTTP_MIN_DELAY_MS=1200
HTTP_MAX_CONCURRENCY=2

# --- Sesión ---------------------------------------------------------------
SESSION_MAX_REAUTH_ATTEMPTS=1

# --- Logging: debug | info | warn | error | silent -------------------------
LOG_LEVEL=info
